# ==============================================================================
# UPITRA - Environment Variables Template (.env.example)
# Salin berkas ini ke .env dan isi dengan kredensial rahasia server Anda.
# JANGAN PERNAH MENG-COMMIT BERKAS .env DENGAN KREDENSIAL ASLI KE REPO GIT!
# ==============================================================================

NODE_ENV="development"
PORT="3000"

# PostgreSQL Database Configuration
DB_NAME="GANTI_DENGAN_NAMA_DATABASE_PRODUKSI"
DB_USER="GANTI_DENGAN_USER_DATABASE"
DB_PASSWORD="GANTI_DENGAN_PASSWORD_DATABASE_YANG_KUAT_MIN_16_KARAKTER"

# Connection String untuk Prisma ORM
DATABASE_URL="postgresql://GANTI_DENGAN_USER_DATABASE:GANTI_DENGAN_PASSWORD_DATABASE@127.0.0.1:5432/GANTI_DENGAN_NAMA_DATABASE?schema=public"

# Kunci Enkripsi Sesi Admin (Minimal 32 karakter acak hex / base64)
ADMIN_SESSION_SECRET="GANTI_DENGAN_SECRET_ENKRIPSI_MINIMAL_32_KARAKTER_ACAK_SEPERTI_OPENSSL_RAND_BASE64_32"
NEXTAUTH_SECRET="GANTI_DENGAN_SECRET_ENKRIPSI_MINIMAL_32_KARAKTER_ACAK_SEPERTI_OPENSSL_RAND_BASE64_32"
NEXTAUTH_URL="https://upitra.ac.id"

# Inisialisasi Akun Superadmin Awal (Seed)
SEED_ADMIN_EMAIL="admin@upitra.ac.id"
SEED_ADMIN_PASSWORD="GANTI_DENGAN_PASSWORD_ADMIN_BARU_MINIMAL_12_KARAKTER"
