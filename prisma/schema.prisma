// Prisma schema for UPITRA (Universitas Pignatelli Triputra)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  STAFF_PMB
  CONTENT_WRITER
}

enum DegreeLevel {
  DIPLOMA
  BACHELOR
}

enum AdmissionStatus {
  LEAD_SUBMITTED
  CONTACTED
  SCHEDULED_INTERVIEW
  ACCEPTED
  ENROLLED
  REJECTED
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(CONTENT_WRITER)
  articles  Article[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Faculty {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  code        String    @unique
  description String?   @db.Text
  icon        String?
  programs    Program[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Program {
  id             String          @id @default(cuid())
  facultyId      String
  faculty        Faculty         @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  name           String
  slug           String          @unique
  degreeLevel    DegreeLevel     @default(BACHELOR)
  degreeTitle    String?         // e.g. "S.Kom.", "S.M.", "S.Par.", "S.S."
  accreditation  String          @default("Baik Sekali")
  campusLocation String          @default("Surakarta")
  shortDesc      String?         @db.Text
  fullDesc       String?         @db.Text
  careerProspect String?         @db.Text
  curriculum     Json?
  tuitionFeeEst  Decimal?        @db.Decimal(12, 2)
  coverImage     String?
  featured       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  leads          AdmissionLead[]
}

model AdmissionLead {
  id            String          @id @default(cuid())
  fullName      String
  phoneWhatsapp String
  email         String
  highSchool    String
  city          String?
  targetYear    Int             @default(2026)
  programId     String?
  program       Program?        @relation(fields: [programId], references: [id], onDelete: SetNull)
  status        AdmissionStatus @default(LEAD_SUBMITTED)
  notes         String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  summary     String?   @db.Text
  content     String    @db.Text
  category    String    // News, Innovation, Achievement, Campus Life
  coverImage  String?
  published   Boolean   @default(false)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Event {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  description     String   @db.Text
  location        String   // Auditorium Kampus UPITRA Surakarta / Zoom Online
  startDate       DateTime
  endDate         DateTime
  bannerImage     String?
  isOnline        Boolean  @default(false)
  registrationUrl String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CampusTourBooking {
  id            String   @id @default(cuid())
  fullName      String
  phoneWhatsapp String
  email         String
  totalVisitor  Int      @default(1)
  preferredDate DateTime
  notes         String?  @db.Text
  confirmed     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
